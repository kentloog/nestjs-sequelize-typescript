{
    "name": "nest-sequelize-typescript",
    "version": "0.0.1",
    "description": "Nest + sequelize-typescript + JWT + Jest + Swagger",
    "keywords": [
        "nest",
        "nestjs",
        "nest.js",
        "sequelize",
        "sequelize-typescript",
        "orm",
        "nodejs",
        "node.js",
        "node",
        "typescript",
        "jwt",
        "swagger",
        "jest"
    ],
    "author": "Kent Loog",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "db:migrate": "sequelize-cli db:migrate",
        "db:drop": "sequelize-cli db:drop",
        "db:create": "sequelize-cli db:create",
        "db:seed-dev": "sequelize-cli db:seed:all",
        "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed-dev",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.28",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/sequelize": "^11.0.1",
        "@nestjs/swagger": "^11.4.6",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sequelize": "^6.37.8",
        "sequelize-typescript": "^2.1.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.28",
        "@testcontainers/postgresql": "^12.1.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^6.0.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.9.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.2.2",
        "testcontainers": "^12.1.0",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
